import Link from "next/link";
import { ArrowRight } from "lucide-react";
import Container from "@/components/layout/Container";
import Icon from "@/components/ui/Icon";
import BlogIndex from "@/components/blog/BlogIndex";
import { getAllPosts } from "@/lib/posts";
import { buildMetadata, breadcrumbJsonLd, faqJsonLd } from "@/lib/seo";
import AboutSection from "@/components/ui/AboutSection";
import FaqAccordion from "@/components/ui/FaqAccordion";
import SectionHeading from "@/components/ui/SectionHeading";
import { BLOG_ABOUT } from "@/data/blogPageSeo";
import { CATEGORIES } from "@/data/categories";
import { TOOLS, getToolsByCategory, getPopularTools } from "@/data/tools";

export const metadata = buildMetadata({
  title: "Blog: Guides & Tips for Free Online Tools",
  description:
    "Read practical guides on passwords, PDFs, images, calculators, and more. Learn how to get better results from every free tool on Toolslay.",
  path: "/blog",
});

export default async function BlogPage() {
  const posts = await getAllPosts();
  const popular = getPopularTools(8);

  const jsonLd = [
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Blog", path: "/blog" },
    ]),
    faqJsonLd(BLOG_ABOUT.faq),
  ].filter(Boolean);

  return (
    <>
      {jsonLd.map((schema, i) => (
        <script
          key={i}
          type="application/ld+json"
          dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }}
        />
      ))}
      <div className="border-b border-line bg-paper">
        <Container className="py-12 sm:py-14">
          <p className="text-xs font-semibold uppercase tracking-wide text-brand">The Toolslay Blog</p>
          <h1 className="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
            Guides and tips for getting more from free tools
          </h1>
          <p className="mt-3 max-w-2xl text-base text-muted">
            Practical how-tos, comparisons, and quick answers. Each guide links to the tool that does the job,
            so you can read, then try it right away.
          </p>
        </Container>
      </div>

      <Container className="py-10">
        <BlogIndex posts={posts} />
      </Container>

      <section className="border-t border-line bg-paper py-14">
        <Container>
          <div className="mb-8 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end">
            <div>
              <p className="mb-2 text-xs font-semibold uppercase tracking-wide text-brand">Free tools</p>
              <h2 className="font-display text-2xl font-bold text-ink sm:text-3xl">Explore tools by category</h2>
              <p className="mt-2 max-w-2xl text-sm text-muted">
                {TOOLS.length}+ free tools in {CATEGORIES.length} categories. Pick a category to see every tool
                inside it.
              </p>
            </div>
            <Link href="/tools" className="text-sm font-medium text-brand hover:text-brand-dark">
              View all tools →
            </Link>
          </div>

          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {CATEGORIES.map((cat) => {
              const count = getToolsByCategory(cat.slug).length;
              return (
                <Link
                  key={cat.slug}
                  href={`/category/${cat.slug}`}
                  className="group flex items-start gap-4 rounded-card border border-line bg-surface p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-hover"
                >
                  <div
                    className="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg"
                    style={{ backgroundColor: cat.accentLight, color: cat.accent }}
                  >
                    <Icon name={cat.icon} size={22} />
                  </div>
                  <div className="min-w-0 flex-1">
                    <h3 className="font-display text-base font-semibold text-ink group-hover:text-brand">
                      {cat.name}
                    </h3>
                    <p className="mt-1 line-clamp-2 text-sm text-muted">{cat.description}</p>
                    <span className="mt-2 inline-flex items-center gap-1 text-xs font-medium text-brand">
                      {count} tools
                      <ArrowRight size={13} className="transition group-hover:translate-x-0.5" aria-hidden="true" />
                    </span>
                  </div>
                </Link>
              );
            })}
          </div>

          {popular.length > 0 && (
            <div className="mt-10">
              <h3 className="font-display text-base font-semibold text-ink">Popular tools</h3>
              <div className="mt-3 flex flex-wrap gap-2">
                {popular.map((tool) => (
                  <Link
                    key={tool.slug}
                    href={`/tools/${tool.slug}`}
                    className="rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink transition hover:border-brand/50 hover:text-brand"
                  >
                    {tool.name}
                  </Link>
                ))}
              </div>
            </div>
          )}
        </Container>
      </section>

      <Container className="pb-16">
        <AboutSection
          title={BLOG_ABOUT.title}
          lead={BLOG_ABOUT.intro[0]}
          paragraphs={BLOG_ABOUT.intro.slice(1)}
          highlights={BLOG_ABOUT.highlights}
        />
        <section className="mt-8">
          <SectionHeading eyebrow="FAQ" title="Frequently asked questions" />
          <FaqAccordion items={BLOG_ABOUT.faq} columns />
        </section>
      </Container>
    </>
  );
}
